//@version=6
indicator("MTF Confirmation Framework", shorttitle="MTF Confirm", overlay=true)

// -----------------------------------------------------------------------------
// Inputs: Base signal
// -----------------------------------------------------------------------------
string GROUP_BASE_SIGNAL = "Base Signal"

string maType = input.string("EMA", "MA type", options=["EMA", "SMA"], group=GROUP_BASE_SIGNAL)
int fastLength = input.int(20, "Fast MA length", minval=1, group=GROUP_BASE_SIGNAL)
int slowLength = input.int(50, "Slow MA length", minval=1, group=GROUP_BASE_SIGNAL)

// -----------------------------------------------------------------------------
// Inputs: Higher timeframe
// -----------------------------------------------------------------------------
string GROUP_HTF = "Higher Timeframe"

bool htfEnabled = input.bool(true, "Enable HTF confirmation", group=GROUP_HTF)
string htfTimeframe = input.timeframe("60", "HTF timeframe", group=GROUP_HTF)
string htfMaType = input.string("EMA", "HTF MA type", options=["EMA", "SMA"], group=GROUP_HTF)
int htfMaLength = input.int(50, "HTF MA length", minval=1, group=GROUP_HTF)
bool showHtfBackground = input.bool(false, "Show HTF trend background", group=GROUP_HTF)

// -----------------------------------------------------------------------------
// Inputs: External confirmation
// -----------------------------------------------------------------------------
string GROUP_EXTERNAL = "External Confirmation"

bool externalEnabled = input.bool(false, "Enable external confirmation", group=GROUP_EXTERNAL)
string externalSymbol = input.symbol("BINANCE:BTCUSDT", "External symbol", group=GROUP_EXTERNAL)
string externalTimeframe = input.timeframe("", "External timeframe", group=GROUP_EXTERNAL)
int externalMaLength = input.int(50, "External MA length", minval=1, group=GROUP_EXTERNAL)
string externalRelationship = input.string("Same direction", "Relationship", options=["Same direction", "Inverse direction"], group=GROUP_EXTERNAL)
bool showExternalStatus = input.bool(true, "Show external status", group=GROUP_EXTERNAL)

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------
ma(float source, int length, string type) =>
    float smaValue = ta.sma(source, length)
    float emaValue = ta.ema(source, length)

    switch type
        "SMA" => smaValue
        => emaValue

// -----------------------------------------------------------------------------
// Base signal
// -----------------------------------------------------------------------------
float fastMA = ma(close, fastLength, maType)
float slowMA = ma(close, slowLength, maType)

bool longCross = ta.crossover(fastMA, slowMA)
bool shortCross = ta.crossunder(fastMA, slowMA)

// -----------------------------------------------------------------------------
// Higher-timeframe confirmation
// -----------------------------------------------------------------------------
// TradingView's recommended non-repainting HTF pattern is to offset the
// requested expression by one HTF bar and use lookahead_on. This returns the
// last confirmed HTF value consistently on historical and realtime bars.
float htfClose = request.security(
    syminfo.tickerid,
    htfTimeframe,
    close[1],
    lookahead=barmerge.lookahead_on
)

float htfMA = request.security(
    syminfo.tickerid,
    htfTimeframe,
    ma(close, htfMaLength, htfMaType)[1],
    lookahead=barmerge.lookahead_on
)

bool htfBullish = htfClose > htfMA
bool htfBearish = htfClose < htfMA

bool htfLongAllowed = not htfEnabled or htfBullish
bool htfShortAllowed = not htfEnabled or htfBearish

// -----------------------------------------------------------------------------
// External-symbol confirmation
// -----------------------------------------------------------------------------
// An empty timeframe input means "same as chart" in request.security().
float externalClose = request.security(
    externalSymbol,
    externalTimeframe,
    close
)

float externalMA = request.security(
    externalSymbol,
    externalTimeframe,
    ta.ema(close, externalMaLength)
)

bool externalBullish = externalClose > externalMA
bool externalBearish = externalClose < externalMA
bool externalInverse = externalRelationship == "Inverse direction"

bool externalLongCondition = externalInverse ? externalBearish : externalBullish
bool externalShortCondition = externalInverse ? externalBullish : externalBearish

bool externalLongAllowed = not externalEnabled or externalLongCondition
bool externalShortAllowed = not externalEnabled or externalShortCondition

// -----------------------------------------------------------------------------
// Final signals
// -----------------------------------------------------------------------------
// Signals are accepted only after the chart bar is confirmed.
bool longSignal = longCross and barstate.isconfirmed and htfLongAllowed and externalLongAllowed
bool shortSignal = shortCross and barstate.isconfirmed and htfShortAllowed and externalShortAllowed

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------
plot(fastMA, "Fast MA", color=color.orange, linewidth=2)
plot(slowMA, "Slow MA", color=color.blue, linewidth=2)

plotshape(longSignal, title="Long Signal", style=shape.triangleup, location=location.belowbar, size=size.small, text="L")
plotshape(shortSignal, title="Short Signal", style=shape.triangledown, location=location.abovebar, size=size.small, text="S")

color htfBackground = htfBullish ? color.new(color.green, 90) : htfBearish ? color.new(color.red, 90) : na
bgcolor(showHtfBackground and htfEnabled ? htfBackground : na, title="HTF Trend")

// -----------------------------------------------------------------------------
// External confirmation status
// -----------------------------------------------------------------------------
int EXTERNAL_TABLE_COLS = 2
int EXTERNAL_TABLE_ROWS = 5

var table externalStatus = table.new(
    position.top_right,
    EXTERNAL_TABLE_COLS,
    EXTERNAL_TABLE_ROWS,
    border_width=1
)

if barstate.islast
    if showExternalStatus
        string externalTrendText = not externalEnabled ? "Disabled" : externalBullish ? "Bullish" : externalBearish ? "Bearish" : "Neutral"
        string longAllowedText = externalLongAllowed ? "Yes" : "No"
        string shortAllowedText = externalShortAllowed ? "Yes" : "No"

        table.cell(externalStatus, 0, 0, "External", text_halign=text.align_left)
        table.cell(externalStatus, 1, 0, externalSymbol, text_halign=text.align_left)
        table.cell(externalStatus, 0, 1, "Trend", text_halign=text.align_left)
        table.cell(externalStatus, 1, 1, externalTrendText, text_halign=text.align_left)
        table.cell(externalStatus, 0, 2, "Relationship", text_halign=text.align_left)
        table.cell(externalStatus, 1, 2, externalRelationship, text_halign=text.align_left)
        table.cell(externalStatus, 0, 3, "Long allowed", text_halign=text.align_left)
        table.cell(externalStatus, 1, 3, longAllowedText, text_halign=text.align_left)
        table.cell(externalStatus, 0, 4, "Short allowed", text_halign=text.align_left)
        table.cell(externalStatus, 1, 4, shortAllowedText, text_halign=text.align_left)
    else
        table.clear(
            externalStatus,
            0,
            0,
            EXTERNAL_TABLE_COLS - 1,
            EXTERNAL_TABLE_ROWS - 1
        )
